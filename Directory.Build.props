<Project>

  <!-- The language settings and the studio identity every project in the family shares are the
       build kit's, taken from its own folder so this repository builds under the file it ships;
       Directory.Build.targets takes the kit's targets and Directory.Packages.props its pins the same
       way. A consumer imports the same three files, by path from a sibling checkout or through the
       ZeroZero.Build SDK on the package route. -->
  <Import Project="$(MSBuildThisFileDirectory)src\ZeroZero.Build\Sdk\ZeroZero.Build.props" />

  <!-- Versions are per component and live in Versions.props, one property each; a project picks
       its own up as <Version>$(<Key>Version)</Version>. Nothing here sets Version, so a project
       that declares none reports the SDK default — which only the unpublished harness does. -->
  <Import Project="$(MSBuildThisFileDirectory)Versions.props" />

  <!-- The commit every assembly reports alongside its version, which AssemblyVersionText reads back
       off the loaded assembly. The stamp is the primitives package's, shipped in its build folder
       so a consumer adopts it with the one reference; the repository's own projects take the same
       two files here, so there is one definition. -->
  <Import Project="$(MSBuildThisFileDirectory)src\ZeroZero.Primitives\build\ZeroZero.Primitives.props" />
  <Import Project="$(MSBuildThisFileDirectory)src\ZeroZero.Primitives\build\ZeroZero.Primitives.targets" />

  <!-- This repository's packaging metadata. Studio identity (Authors, Company, Copyright) is the
       kit's; per-assembly values (AssemblyTitle, Product, Description) stay in the project that
       owns them. -->
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/0z00z0/0z0-shared</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/0z00z0/0z0-shared</PackageProjectUrl>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- One readme for every package: what the library is, and the fact that the feed authenticates
       every read. Named by PackageReadmeFile above, which only resolves if the file is packed to the
       package root as well. Harmless in a project that does not pack. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)PACKAGE.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
