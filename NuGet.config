<?xml version="1.0" encoding="utf-8"?>
<!--
  The package sources a restore of this repository's projects uses. A project is restored under the
  configuration nearest it on disk, so this file governs the projects under src\ and tests\ wherever
  the build is started from — this repository's own builds, and a consuming repository that
  references those projects by project reference.

  One source, cleared of whatever a machine or a consumer declares above it. Every pin in
  ZeroZero.Packages.props is a public nuget.org package; the studio feed is a publish target and
  nothing here restores from it. Under central package management, more than one source with no
  package source mapping is NU1507, raised once per project, so without this file a consumer on the
  sibling-checkout route collects one warning for every project it takes.

  A consuming repository still declares its own sources, and on the package route its own mapping.
  That file governs its own projects; this one governs these.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
