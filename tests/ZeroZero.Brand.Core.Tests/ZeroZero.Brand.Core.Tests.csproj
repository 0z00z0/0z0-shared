<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0, matching the project under test. Nothing here references
         ZeroZero.Brand.WinUI: the Windows App SDK bootstrapper blocks on a runner with no desktop
         session, so a WinUI-coupled test assembly would hang CI rather than fail it (issue #13). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ZeroZero.Brand.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroZero.Brand.Core\ZeroZero.Brand.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- The brand dictionary declares the palette a second time, in the form XAML consumes, and the
         About control names the brand face on its own. Both live in a Windows-only project this one
         cannot reference, so they are copied in as data and held against the constants as text.
         Without that a retyped hex or a renamed face passes every test while the screen drifts. -->
    <None Include="..\..\src\ZeroZero.Brand.WinUI\Themes\BrandResources.xaml"
          Link="BrandResources.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ZeroZero.Brand.WinUI\BrandAboutControl.xaml"
          Link="BrandAboutControl.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
