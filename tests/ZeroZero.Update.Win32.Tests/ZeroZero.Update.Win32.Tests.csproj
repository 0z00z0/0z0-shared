<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0, matching the project under test. Nothing here reaches a screen: the flow
         runs over a recording service and recording prompts, and the sentences are read back
         rather than shown. Windows only, as the assembly under test. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ZeroZero.Update.Win32.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The assembly under test declares itself Windows-only; without the same declaration every
         call into it is a CA1416 warning. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroZero.Update.Win32\ZeroZero.Update.Win32.csproj" />
  </ItemGroup>

  <!-- Test helpers shared with other test projects, each linked where it is used. -->
  <ItemGroup>
    <Compile Include="..\Shared\RecordingLogSink.cs" Link="Shared\RecordingLogSink.cs" />
    <Compile Include="..\Shared\Polling.cs" Link="Shared\Polling.cs" />
    <Compile Include="..\Shared\SynchronousProgress.cs" Link="Shared\SynchronousProgress.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
