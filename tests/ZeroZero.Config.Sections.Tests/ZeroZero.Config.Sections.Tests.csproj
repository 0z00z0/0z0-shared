<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0, matching the project under test. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ZeroZero.Config.Sections.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroZero.Config.Sections\ZeroZero.Config.Sections.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The settings file the migration is proven against, copied rather than embedded so a failure
         can be opened in a text editor and looked at. -->
    <None Update="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
