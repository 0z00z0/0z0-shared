<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0, matching the project under test. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ZeroZero.Mqtt.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroZero.Mqtt\ZeroZero.Mqtt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- The panel's resource file holds the same en-GB as MqttStrings.Builtin, in the form a WinUI
         host loads. It lives in a Windows-only project this one cannot reference, so it is copied in
         as data and the two are compared as text. Without that the .resw drifts silently: a reworded
         string still passes every test while the panel keeps showing the old wording. -->
    <None Include="..\..\src\ZeroZero.Mqtt.WinUI\Strings\en-GB\Resources.resw"
          Link="Resources.resw" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
