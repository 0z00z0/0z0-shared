<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0, matching the project under test. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ZeroZero.Mqtt.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroZero.Mqtt\ZeroZero.Mqtt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- The translator's files, read as data: the context notes are not compiled into the assembly. -->
    <None Include="..\..\src\ZeroZero.Mqtt\Texts.resx" Link="Translations\Texts.resx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ZeroZero.Mqtt\Texts.nb.resx" Link="Translations\Texts.nb.resx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The panel's setup object needs nothing from WinUI, so its source is compiled in here and the
         construction from a live connection is tested against the loopback broker. -->
    <Compile Include="..\..\src\ZeroZero.Mqtt.WinUI\MqttPanelSetup.cs" Link="Linked\MqttPanelSetup.cs" />
    <Compile Include="..\Shared\RecordingLogSink.cs" Link="Shared\RecordingLogSink.cs" />
    <Compile Include="..\Shared\UiCulture.cs" Link="Shared\UiCulture.cs" />
    <Compile Include="..\Shared\TranslationFiles.cs" Link="Shared\TranslationFiles.cs" />
  </ItemGroup>

</Project>
