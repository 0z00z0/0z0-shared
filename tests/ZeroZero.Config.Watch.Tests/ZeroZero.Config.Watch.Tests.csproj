<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0, matching the project under test. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ZeroZero.Config.Watch.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroZero.Config.Watch\ZeroZero.Config.Watch.csproj" />
    <!-- Test-only: the seam between the watcher and a section of a shared document. The shipped
         watcher references the plain assembly alone, and this reference does not change that. -->
    <ProjectReference Include="..\..\src\ZeroZero.Config.Sections\ZeroZero.Config.Sections.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- The quiet window is crossed by moving a clock, never by sleeping for it. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

</Project>
