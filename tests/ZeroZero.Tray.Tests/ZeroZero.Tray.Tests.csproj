<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0, matching the project under test. The taskbar and registry tests read the
         real desktop, so the project runs on Windows only. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ZeroZero.Tray.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The tests' own taskbar read uses the same source-generated interop as the assemblies under test. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The assembly under test declares itself Windows-only; without the same declaration every
         call into it is a CA1416 warning. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroZero.Tray\ZeroZero.Tray.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The framework-free half of the WinUI host, compiled in as linked source rather than
         referenced: a test assembly that references a WinUI assembly hangs a runner with no
         desktop session (issue #13). The host itself is measured through the interactive harness
         as a child process. -->
    <Compile Include="..\..\src\ZeroZero.Tray.WinUI\TrayClick.cs" Link="Linked\TrayClick.cs" />
    <Compile Include="..\..\src\ZeroZero.Tray.WinUI\TrayClickPolicy.cs" Link="Linked\TrayClickPolicy.cs" />
    <Compile Include="..\..\src\ZeroZero.Tray.WinUI\TrayIconFileCache.cs" Link="Linked\TrayIconFileCache.cs" />
    <Compile Include="..\..\src\ZeroZero.Tray.WinUI\TrayIconImage.cs" Link="Linked\TrayIconImage.cs" />
    <Compile Include="..\..\src\ZeroZero.Tray.WinUI\TrayMenuItem.cs" Link="Linked\TrayMenuItem.cs" />
    <Compile Include="..\..\src\ZeroZero.Tray.WinUI\TrayTooltip.cs" Link="Linked\TrayTooltip.cs" />
    <Compile Include="..\..\src\ZeroZero.Tray.WinUI\TrayTooltipLine.cs" Link="Linked\TrayTooltipLine.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
