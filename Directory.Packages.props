<Project>

  <!-- The family's pins are the build kit's, imported so this repository and every consumer that
       imports the same file resolve one version per third-party package. A package only this
       repository needs would be added below the import; there is none. -->
  <Import Project="$(MSBuildThisFileDirectory)src\ZeroZero.Build\Sdk\ZeroZero.Packages.props" />

</Project>
