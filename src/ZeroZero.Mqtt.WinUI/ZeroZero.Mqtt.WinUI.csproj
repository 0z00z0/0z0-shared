<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ZeroZero.Mqtt.WinUI</RootNamespace>
    <Version>$(MqttVersion)</Version>

    <!-- WinUI 3 / Windows App SDK, unpackaged (no MSIX) — a class library consumed by unpackaged
         apps, so it must not pull in packaging tooling itself. -->
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>

    <AssemblyTitle>ZeroZero.Mqtt.WinUI</AssemblyTitle>
    <Product>ZeroZero.Mqtt.WinUI</Product>
    <Description>The MQTT settings panel: master switch, live status, device identity, a staged broker block and one row per application-declared publish group.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <!-- The family's pin in the build kit's ZeroZero.Packages.props is a ceiling: a consuming app
         holds a direct reference at that version, and a direct reference below a transitive one is
         NU1605, an error. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroZero.Mqtt\ZeroZero.Mqtt.csproj" />
    <!-- The log sink the panel's guarded handlers report to. -->
    <ProjectReference Include="..\ZeroZero.Primitives\ZeroZero.Primitives.csproj" />
    <!-- The info bubble. It carries no MQTT vocabulary and no studio identity, so it lives in the
         controls foundation assembly rather than with the brand: a panel that wants a bubble must
         not drag the font pack and the About window along with it. -->
    <ProjectReference Include="..\ZeroZero.Controls.WinUI\ZeroZero.Controls.WinUI.csproj" />
    <!-- The panel compiles against nothing in the discovery assembly. It is referenced because this
         project is the module's entry point: one project reference is the documented contract, so
         the chain below it has to be complete here or a consumer that took that one reference is
         short an assembly it was told it already had. -->
    <ProjectReference Include="..\ZeroZero.Mqtt.Discovery\ZeroZero.Mqtt.Discovery.csproj" />
  </ItemGroup>

</Project>
