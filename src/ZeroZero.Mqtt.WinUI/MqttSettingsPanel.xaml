<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ZeroZero.Mqtt.WinUI.MqttSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="using:ZeroZero.Controls.WinUI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    FontFamily="{ThemeResource MqttPanelFontFamily}">

    <!-- Alignment, text and font rules: docs/consume-mqtt-settings-panel.md, "Inside the panel".
         No user-facing text here; every keyed style that renders text repeats the font key. -->
    <UserControl.Resources>
        <x:Double x:Key="MqttFieldWidth">240</x:Double>

        <!-- Trims the toolkit's 68 px card floor so single-line rows reserve no extra height; cards
             carrying a description still grow past it. Scoped to the panel root so it also reaches
             the group rows built in code below. -->
        <x:Double x:Key="SettingsCardMinHeight">52</x:Double>

        <Style x:Key="MqttTextFieldStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{ThemeResource MqttPanelFontFamily}"/>
            <Setter Property="Width" Value="{StaticResource MqttFieldWidth}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <!-- PasswordBox has no TextAlignment: the masked run follows the control's content alignment
             instead, which is why this style differs from the TextBox one by a property name rather
             than by intent. -->
        <Style x:Key="MqttPasswordFieldStyle" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{ThemeResource MqttPanelFontFamily}"/>
            <Setter Property="Width" Value="{StaticResource MqttFieldWidth}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="MqttComboFieldStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{ThemeResource MqttPanelFontFamily}"/>
            <Setter Property="Width" Value="{StaticResource MqttFieldWidth}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- The one small toned-down label used for every row's sub-text and for the panel's status
             lines, so the secondary tier is defined once. -->
        <Style x:Key="MqttHintStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource MqttPanelFontFamily}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{ThemeResource MqttPanelSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- The same tier for the closed Broker line, which holds drawn marks a TextBlock cannot. -->
        <Style x:Key="MqttHintRichStyle" TargetType="RichTextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource MqttPanelFontFamily}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{ThemeResource MqttPanelSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="IsTextSelectionEnabled" Value="False"/>
        </Style>
        <!-- A magnifier after a value found rather than set; drawn in the line's own brush. -->
        <Style x:Key="MqttDetectedMarkStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{ThemeResource MqttPanelSecondaryBrush}"/>
            <Setter Property="StrokeThickness" Value="1.25"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <!-- The Status block's own two tiers. The label is the elastic half and gives way first; the
             value is the field width every other row on this panel uses, so the right edge is the
             panel's right edge here too. -->
        <Style x:Key="MqttStatusLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource MqttPanelFontFamily}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{ThemeResource MqttPanelBodyBrush}"/>
        </Style>
        <!-- Never changes a size: one line, an ellipsis, the whole string on a hover tip set in code;
             an error changes colour only. -->
        <Style x:Key="MqttStatusValueStyle" TargetType="TextBlock"
               BasedOn="{StaticResource MqttHintStyle}">
            <Setter Property="Width" Value="{StaticResource MqttFieldWidth}"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- A style, never a brush set in code: a brush fetched at run time resolves against the
             application's theme and inverts inside a subtree with its own RequestedTheme. -->
        <Style x:Key="MqttStatusErrorStyle" TargetType="TextBlock"
               BasedOn="{StaticResource MqttStatusValueStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
        </Style>

        <Style x:Key="MqttResultStyle" TargetType="TextBlock"
               BasedOn="{StaticResource MqttHintStyle}"/>
        <Style x:Key="MqttResultErrorStyle" TargetType="TextBlock"
               BasedOn="{StaticResource MqttHintStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- Sections in the order the questions arise; the last two are set once, so start collapsed.
         The heading introducing the panel belongs to the host page. -->
    <StackPanel Spacing="4">

        <!-- No section heading of its own: the master switch is one card at the top of the panel,
             the way every other page opens, and a heading here would only repeat the card's own
             name back at it. -->
        <controls:SettingsCard x:Name="PublishCard">
            <controls:SettingsCard.Description>
                <TextBlock x:Name="PublishDescriptionText" Style="{StaticResource MqttHintStyle}"/>
            </controls:SettingsCard.Description>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <shared:InfoIcon x:Name="PublishInfoIcon"/>
                <ToggleSwitch x:Name="EnabledToggle" Toggled="OnEnabledToggled"/>
            </StackPanel>
        </controls:SettingsCard>

        <!-- Hidden rather than disabled while publishing is off: a greyed panel still invites
             reading, and none of it has an answer until the feature is on. -->
        <StackPanel x:Name="DetailPanel" Spacing="4">

            <shared:SettingsSectionHeader x:Name="StatusHeader"
                                          Foreground="{ThemeResource MqttPanelHeadingBrush}"/>

            <!-- Not SettingsCards: a card with unbounded content collapses its header to zero width
                 and grows without bound. See docs/consume-mqtt-settings-panel.md, "Inside the panel". -->
            <Border x:Name="StatusBorder"
                    Background="{ThemeResource MqttPanelCardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="16,12,16,12">
                <Grid ColumnSpacing="8" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- The only elastic column, so it is the only thing a narrow window or a row
                             button can take space from. -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- First, because it answers the question the rest of the panel raises: whether
                         these values were found or chosen. -->
                    <TextBlock x:Name="ConnectionLabel" Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource MqttStatusLabelStyle}"/>
                    <shared:InfoIcon x:Name="ConnectionInfoIcon" Grid.Row="0" Grid.Column="2"/>
                    <TextBlock x:Name="DetectText" Grid.Row="0" Grid.Column="3" Text="—"
                               Style="{StaticResource MqttStatusValueStyle}"/>

                    <TextBlock x:Name="BrokerInUseLabel" Grid.Row="1" Grid.Column="0"
                               Style="{StaticResource MqttStatusLabelStyle}"/>
                    <shared:InfoIcon x:Name="BrokerInUseInfoIcon" Grid.Row="1" Grid.Column="2"/>
                    <TextBlock x:Name="BrokerStatusText" Grid.Row="1" Grid.Column="3" Text="—"
                               Style="{StaticResource MqttStatusValueStyle}"/>

                    <TextBlock x:Name="LastPublishLabel" Grid.Row="2" Grid.Column="0"
                               Style="{StaticResource MqttStatusLabelStyle}"/>
                    <!-- In the row's own column, not the value's: the value keeps the field width
                         whatever the button does, so a narrow window trims the label rather than the
                         fact. -->
                    <Button x:Name="PublishNowBtn" Grid.Row="2" Grid.Column="1"
                            Click="OnPublishNowClicked"
                            VerticalAlignment="Center"
                            MinHeight="0" Padding="10,3,10,3" FontSize="12"/>
                    <shared:InfoIcon x:Name="LastPublishInfoIcon" Grid.Row="2" Grid.Column="2"/>
                    <TextBlock x:Name="LastPublishText" Grid.Row="2" Grid.Column="3" Text="—"
                               Style="{StaticResource MqttStatusValueStyle}"/>

                    <TextBlock x:Name="LastCommandLabel" Grid.Row="3" Grid.Column="0"
                               Style="{StaticResource MqttStatusLabelStyle}"/>
                    <shared:InfoIcon x:Name="LastCommandInfoIcon" Grid.Row="3" Grid.Column="2"/>
                    <TextBlock x:Name="LastCommandText" Grid.Row="3" Grid.Column="3" Text="—"
                               Style="{StaticResource MqttStatusValueStyle}"/>
                </Grid>
            </Border>

            <!-- Before Broker: which device this is comes before how it connects. The name is
                 cosmetic and commits on its own; the id is destructive and changes only through its
                 own confirmation dialogue. Neither rides the Apply batch, so neither can be lost
                 behind a collapsed group. -->
            <shared:SettingsSectionHeader x:Name="DeviceHeader"
                                          Foreground="{ThemeResource MqttPanelHeadingBrush}"/>

            <controls:SettingsCard x:Name="DeviceNameCard">
                <controls:SettingsCard.Description>
                    <TextBlock x:Name="DeviceNameDescription" Style="{StaticResource MqttHintStyle}"/>
                </controls:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="DeviceNameSavedText" Style="{StaticResource MqttHintStyle}"
                               Foreground="{ThemeResource MqttPanelAccentBrush}"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                    <shared:InfoIcon x:Name="DeviceNameInfoIcon"/>
                    <TextBox x:Name="DeviceNameBox" Style="{StaticResource MqttTextFieldStyle}"
                             TextChanged="OnDeviceNameEdited"
                             LostFocus="OnDeviceNameCommitted" KeyDown="OnDeviceNameKeyDown"/>
                </StackPanel>
            </controls:SettingsCard>

            <!-- Read-only with a button, not a text box: the id is the unique_id stem and every topic
                 segment, so editing it in place would make a rename a side effect of a keystroke. -->
            <controls:SettingsCard x:Name="DeviceIdCard">
                <controls:SettingsCard.Description>
                    <TextBlock x:Name="DeviceIdDescription" Style="{StaticResource MqttHintStyle}"/>
                </controls:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <shared:InfoIcon x:Name="DeviceIdInfoIcon"/>
                    <TextBlock x:Name="DeviceIdText" VerticalAlignment="Center"
                               Style="{StaticResource MqttHintStyle}"
                               IsTextSelectionEnabled="True"/>
                    <Button x:Name="ChangeDeviceIdBtn" Click="OnChangeDeviceIdClicked"/>
                </StackPanel>
            </controls:SettingsCard>

            <!-- A section, headed like every other one. An expander's own Header draws inside the
                 card chrome and reads as a settings row, not as a title, so the name lives above the
                 chrome and the expander does not repeat it.

                 The unapplied marker sits beside the heading, OUTSIDE the expander: a staged edit
                 that only a collapsed group can show is an edit that is lost at the next reload with
                 nothing on screen having said so. -->
            <shared:SettingsSectionHeader x:Name="BrokerHeader"
                                          Foreground="{ThemeResource MqttPanelHeadingBrush}">
                <shared:SettingsSectionHeader.Trailing>
                    <TextBlock x:Name="BrokerDirtyText" Style="{StaticResource MqttHintStyle}"
                               Foreground="{ThemeResource MqttPanelAccentBrush}"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                </shared:SettingsSectionHeader.Trailing>
            </shared:SettingsSectionHeader>

            <controls:SettingsExpander x:Name="BrokerExpander" IsExpanded="False">
                <controls:SettingsExpander.Description>
                    <RichTextBlock x:Name="BrokerExpanderDescription" Style="{StaticResource MqttHintRichStyle}"/>
                </controls:SettingsExpander.Description>

                <controls:SettingsExpander.Items>
                    <!-- Host carries no description: one that could only restate the header is words
                         without information, and the row reads better without it. -->
                    <controls:SettingsCard x:Name="HostCard">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <shared:InfoIcon x:Name="HostInfoIcon"/>
                            <TextBox x:Name="HostBox" Style="{StaticResource MqttTextFieldStyle}"
                                     TextChanged="OnBrokerFieldEdited"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- Host then Port then Transport, because that is the order the answers narrow
                         in: which machine, which door, which language. The typed box and its error
                         line share the field width, so an expanded port row keeps the same right
                         edge as every other. -->
                    <controls:SettingsCard x:Name="PortCard">
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="PortDescription" Style="{StaticResource MqttHintStyle}"/>
                        </controls:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <shared:InfoIcon x:Name="PortInfoIcon"/>
                            <StackPanel Spacing="4" HorizontalAlignment="Right">
                                <ComboBox x:Name="PortCombo" Style="{StaticResource MqttComboFieldStyle}"
                                          SelectionChanged="OnPortSelectionChanged"/>
                                <TextBox x:Name="PortCustomBox" Style="{StaticResource MqttTextFieldStyle}"
                                         Visibility="Collapsed" TextChanged="OnBrokerFieldEdited"/>
                                <TextBlock x:Name="PortErrorText" Visibility="Collapsed"
                                           Style="{StaticResource MqttHintStyle}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           Width="{StaticResource MqttFieldWidth}" TextAlignment="Right"/>
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- Automatic is first so it is the default selection, matching the setting. -->
                    <controls:SettingsCard x:Name="TransportCard">
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="TransportDescription" Style="{StaticResource MqttHintStyle}"/>
                        </controls:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <shared:InfoIcon x:Name="TransportInfoIcon"/>
                            <ComboBox x:Name="TransportCombo" Style="{StaticResource MqttComboFieldStyle}"
                                      SelectionChanged="OnBrokerSelectionChanged"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- Named away from the acronym, and silent about ports: the port is its own
                         setting and may be anything the broker is served on. Three-state like Port
                         and Transport, and for the same reason — whether a broker serves a port in
                         cipher is the broker's business, so Automatic is first. -->
                    <controls:SettingsCard x:Name="EncryptionCard">
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="EncryptionDescription" Style="{StaticResource MqttHintStyle}"/>
                        </controls:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <shared:InfoIcon x:Name="EncryptionInfoIcon"/>
                            <ComboBox x:Name="EncryptionCombo" Style="{StaticResource MqttComboFieldStyle}"
                                      SelectionChanged="OnBrokerSelectionChanged"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- Directly under Encryption, because it decides nothing while the link is in
                         clear text. The line below the dropdown says what accepting any
                         certificate gives up. -->
                    <controls:SettingsCard x:Name="TrustCard">
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="TrustDescription" Style="{StaticResource MqttHintStyle}"/>
                        </controls:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <shared:InfoIcon x:Name="TrustInfoIcon"/>
                            <StackPanel Spacing="4" HorizontalAlignment="Right">
                                <ComboBox x:Name="TrustCombo" Style="{StaticResource MqttComboFieldStyle}"
                                          SelectionChanged="OnBrokerSelectionChanged"/>
                                <TextBlock x:Name="TrustNoteText" Visibility="Collapsed"
                                           Style="{StaticResource MqttHintStyle}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           Width="{StaticResource MqttFieldWidth}" TextAlignment="Right"/>
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- The credentials sit below the addressing: they decide whether the broker
                         accepts the session, never which door it knocks on. -->
                    <controls:SettingsCard x:Name="UsernameCard">
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="UsernameDescription" Style="{StaticResource MqttHintStyle}"/>
                        </controls:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <shared:InfoIcon x:Name="UsernameInfoIcon"/>
                            <TextBox x:Name="UsernameBox" Style="{StaticResource MqttTextFieldStyle}"
                                     TextChanged="OnBrokerFieldEdited"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="PasswordCard">
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="PasswordDescription" Style="{StaticResource MqttHintStyle}"/>
                        </controls:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <shared:InfoIcon x:Name="PasswordInfoIcon"/>
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource MqttPasswordFieldStyle}"
                                         PasswordChanged="OnBrokerFieldEdited"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- Last in the section, and the only field here that is about the consumer
                         rather than the broker. -->
                    <controls:SettingsCard x:Name="PrefixCard">
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="PrefixDescription" Style="{StaticResource MqttHintStyle}"/>
                        </controls:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <shared:InfoIcon x:Name="PrefixInfoIcon"/>
                            <TextBox x:Name="PrefixBox" Style="{StaticResource MqttTextFieldStyle}"
                                     TextChanged="OnBrokerFieldEdited"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- Apply sits at the far right, where every field above puts its own edge, so
                         the one control that commits the section lands on the panel's action edge
                         instead of hiding at the start of a row. -->
                    <controls:SettingsCard x:Name="ApplyCard"
                                           ContentAlignment="Vertical"
                                           HorizontalContentAlignment="Stretch">
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="ApplyDescription" Style="{StaticResource MqttHintStyle}"/>
                        </controls:SettingsCard.Description>
                        <StackPanel Spacing="8" Margin="0,4,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="TestBtn" Click="OnTestConnectionClicked"/>
                                    <ProgressRing x:Name="TestProgress" Width="16" Height="16"
                                                  IsActive="False" Visibility="Collapsed"
                                                  VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AppliedText" VerticalAlignment="Center"
                                               Style="{StaticResource MqttHintStyle}"
                                               Foreground="{ThemeResource MqttPanelAccentBrush}"
                                               Visibility="Collapsed"/>
                                    <shared:InfoIcon x:Name="TestInfoIcon"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="ApplyBtn" Click="OnApplyClicked"/>
                                </StackPanel>
                            </Grid>
                            <!-- Names which values were tested: under the batch save model the fields
                                 and the saved settings can disagree, and a green result must not be
                                 ambiguous. Also the sweep's progress line, endpoint by endpoint. -->
                            <TextBlock x:Name="TestResultText" Style="{StaticResource MqttHintStyle}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- Last, and closed: each group is named by the application that declared it, so what a
                 toggle covers needs no explaining beyond its own name, and the set is changed far
                 less often than anything above it. -->
            <shared:SettingsSectionHeader x:Name="PublishHeader"
                                          Foreground="{ThemeResource MqttPanelHeadingBrush}"/>

            <!-- The rows are built in code from MqttPanelSetup.Groups: the panel renders the
                 application's group vocabulary and declares none of its own. Empty Items here, one
                 SettingsCard per declared PublishGroup at load. -->
            <controls:SettingsExpander x:Name="PublishExpander" IsExpanded="False">
                <controls:SettingsExpander.Description>
                    <TextBlock x:Name="PublishExpanderDescription" Style="{StaticResource MqttHintStyle}"/>
                </controls:SettingsExpander.Description>
            </controls:SettingsExpander>
        </StackPanel>

        <!-- Outside the detail sections: a removal switches publishing off, and its outcome stays on screen. -->
        <StackPanel x:Name="RemovalPanel" Spacing="4" Visibility="Collapsed">
            <shared:SettingsSectionHeader x:Name="RemovalHeader"
                                          Foreground="{ThemeResource MqttPanelHeadingBrush}"/>
            <controls:SettingsCard x:Name="RemovalCard">
                <controls:SettingsCard.Description>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="RemovalDescription" Style="{StaticResource MqttHintStyle}"/>
                        <TextBlock x:Name="RemovalResultText" Style="{StaticResource MqttResultStyle}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </controls:SettingsCard.Description>
                <Button x:Name="RemoveDeviceBtn" Click="OnRemoveDeviceClicked"/>
            </controls:SettingsCard>
        </StackPanel>
    </StackPanel>
</UserControl>
