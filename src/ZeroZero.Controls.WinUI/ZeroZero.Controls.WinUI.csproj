<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ZeroZero.Controls.WinUI</RootNamespace>
    <Version>$(ControlsVersion)</Version>

    <!-- WinUI 3 / Windows App SDK, unpackaged (no MSIX) — a class library consumed by unpackaged
         apps, so it must not pull in packaging tooling itself. -->
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>

    <AssemblyTitle>ZeroZero.Controls.WinUI</AssemblyTitle>
    <Product>ZeroZero.Controls.WinUI</Product>
    <Description>Identity-free WinUI 3 controls for ZeroZero Software apps: the settings-row info bubble.</Description>
  </PropertyGroup>

  <!--
    Foundation, so no project reference at all: a control here carries no studio identity, resolves
    stock theme brushes and ships no font, and any UI component may take it without dragging the
    brand assembly's font pack and About window along. The two versions are the family's pins in
    the build kit's ZeroZero.Packages.props, which Directory.Packages.props imports; a pin moves
    there and nowhere else, so a consumer under the kit resolves the runtime this library was built
    against.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

</Project>
