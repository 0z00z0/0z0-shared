<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ZeroZero.Controls.WinUI.TextPromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <!-- Frameless: the presenter draws a border and no title bar, so the root padding is the whole
         margin and the title tier is the window's own. Two tiers of text above the field, an
         optional note beneath it, and a two-column button row of equal widths with the confirm on
         the right, where a Windows dialogue puts its default action. -->
    <Grid x:Name="Root" Padding="20">
        <StackPanel Spacing="8">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBox x:Name="Field" Margin="0,4,0,0"
                     TextChanged="OnTextChanged" KeyDown="OnFieldKeyDown"/>
            <TextBlock x:Name="NoteText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Grid ColumnSpacing="8" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelButton" Grid.Column="0" HorizontalAlignment="Stretch"
                        Click="OnCancelClicked"/>
                <Button x:Name="ConfirmButton" Grid.Column="1" HorizontalAlignment="Stretch"
                        Style="{ThemeResource AccentButtonStyle}" Click="OnConfirmClicked"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
