<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZeroZero.Brand.WinUI.TestHarness.TitleBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A Mica window with the system title bar, the ground the defect shows on: Mica does not
         paint the caption area, so a dark page with an untreated bar shows a light strip behind
         its caption buttons. No page background, so the backdrop is what the page sits on. -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <StackPanel x:Name="Body" Padding="24,20,24,24" Spacing="8">
            <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="Note" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
