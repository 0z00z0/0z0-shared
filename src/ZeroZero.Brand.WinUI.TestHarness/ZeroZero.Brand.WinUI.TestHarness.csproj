<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ZeroZero.Brand.WinUI.TestHarness</RootNamespace>

    <!-- The merged app PRI is built from the app's own resources, so an app declares this even
         where every library it references already has: without it MakePRI measures the en-GB
         resources reaching it against its en-US assumption and reports PRI257. The same property a
         consuming app needs, on the repository's own app. -->
    <DefaultLanguage>en-GB</DefaultLanguage>

    <!-- Interactive manual test rig only: launches BrandAboutWindow with this repo's own sample
         data so it can be eyeballed without building/running ChargeKeeper or HyperVManagerTray.
         Not published, not referenced by consumers, not part of the public library surface. -->
    <IsPackable>false</IsPackable>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>

    <!-- Declares PerMonitorV2 DPI awareness so the harness renders BrandAboutWindow sharp on
         high-DPI displays instead of being bitmap-stretched (blurry) by the OS, and the common
         controls 6 dependency the task dialog needs. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroZero.Brand.Core\ZeroZero.Brand.Core.csproj" />
    <ProjectReference Include="..\ZeroZero.Brand.WinUI\ZeroZero.Brand.WinUI.csproj" />
    <!-- The rig covers every shared WinUI component in this repository, not only the About window:
         the MQTT settings panel is driven here from fabricated state so it can be seen rendered. -->
    <ProjectReference Include="..\ZeroZero.Mqtt.WinUI\ZeroZero.Mqtt.WinUI.csproj" />
    <!-- Direct, not only through the panel: the rig walks to an info bubble by type to open its
         flyout on screen. -->
    <ProjectReference Include="..\ZeroZero.Controls.WinUI\ZeroZero.Controls.WinUI.csproj" />
    <!-- Direct, not only through the About window: the rig sizes its own windows through the
         monitor metrics and shows the native dialogs on screen. -->
    <ProjectReference Include="..\ZeroZero.Win32\ZeroZero.Win32.csproj" />
  </ItemGroup>

</Project>
