<Project Sdk="Microsoft.NET.Sdk">

  <!-- The build kit's unpackaged WinUI application block, imported the way a consuming application
       imports it: OutputType, target framework, minimum platform, UseWinUI, no MSIX, a runtime
       identifier from the process architecture, DefaultLanguage en-GB, and the manifest written
       from the kit's template with the trust block, per-monitor-v2 DPI awareness and the
       common-controls-6 dependency the task dialog needs. The harness is the one project in the
       repository that takes the block, so the block, the manifest writer and the guards behind
       them are exercised by this repository's own build. -->
  <Import Project="$(ZeroZeroBuildDir)Sdk\ZeroZero.WinUIApp.props" />

  <PropertyGroup>
    <RootNamespace>ZeroZero.Brand.WinUI.TestHarness</RootNamespace>

    <!-- Interactive manual test rig only: launches BrandAboutWindow with this repo's own sample
         data so it can be eyeballed without building/running ChargeKeeper or HyperVManagerTray.
         Not published, not referenced by consumers, not part of the public library surface. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroZero.Brand.Core\ZeroZero.Brand.Core.csproj" />
    <ProjectReference Include="..\ZeroZero.Brand.WinUI\ZeroZero.Brand.WinUI.csproj" />
    <!-- The rig covers every shared WinUI component in this repository, not only the About window:
         the MQTT settings panel is driven here from fabricated state so it can be seen rendered. -->
    <ProjectReference Include="..\ZeroZero.Mqtt.WinUI\ZeroZero.Mqtt.WinUI.csproj" />
    <!-- Direct, not only through the panel: the rig walks to an info bubble by type to open its
         flyout on screen. -->
    <ProjectReference Include="..\ZeroZero.Controls.WinUI\ZeroZero.Controls.WinUI.csproj" />
    <!-- Direct, not only through the About window: the rig sizes its own windows through the
         monitor metrics and shows the native dialogs on screen. -->
    <ProjectReference Include="..\ZeroZero.Win32\ZeroZero.Win32.csproj" />
  </ItemGroup>

</Project>
