<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ZeroZero.Config.Sections</RootNamespace>
    <Version>$(ConfigVersion)</Version>

    <AssemblyTitle>ZeroZero.Config.Sections</AssemblyTitle>
    <Product>ZeroZero.Config.Sections</Product>
    <Description>A settings document addressed one section at a time: a section is read and written on its own, every sibling section and comment is carried through byte for byte, no write ever adds a comment, and a migration writes the new file without touching the old one.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The document walk, the splice and the migration's proof are internal because they are
         mechanism, not surface; the tests drive them directly so each can be shown to fail. -->
    <InternalsVisibleTo Include="ZeroZero.Config.Sections.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroZero.Config\ZeroZero.Config.csproj" />
  </ItemGroup>

</Project>
