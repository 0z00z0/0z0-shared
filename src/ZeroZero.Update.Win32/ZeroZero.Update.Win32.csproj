<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0: the orchestration and the wording touch no XAML, so a headless tool can take
         this and supply prompts of its own. The window that shows them is ZeroZero.Update.WinUI.
         The assembly declares itself Windows-only through SupportedOSPlatform, as the one it takes
         does. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ZeroZero.Update.Win32</RootNamespace>
    <Version>$(UpdateVersion)</Version>

    <AssemblyTitle>ZeroZero.Update.Win32</AssemblyTitle>
    <Product>ZeroZero.Update.Win32</Product>
    <Description>The update component's orchestration: the check-ask-download-verify-launch flow that hands over to the application's own shutdown, what it asks and says as plain sentences, and the interface a surface implements to show them. Carries ZeroZero.Update with it; the shared window that shows them is ZeroZero.Update.WinUI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- This project carries the one below it, so a headless tool taking it adopts the whole flow. -->
    <ProjectReference Include="..\ZeroZero.Update\ZeroZero.Update.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZeroZero.Update.Win32.Tests" />
  </ItemGroup>

</Project>
