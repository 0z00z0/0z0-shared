<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ZeroZero.Update.WinUI.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:brand="using:ZeroZero.Brand.WinUI">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <!-- One window for every step of an update, shown one stage at a time: the question, the
         download, and a message with one way out. Frameless on a Mica backdrop, as the About
         window is, with the brand rule across the top, the studio's typeface throughout and the
         bracket button for every action. -->
    <Grid x:Name="Root">
        <Grid.Resources>
            <ResourceDictionary>
                <!-- The brand face, addressed under the brand assembly's own folder: the one
                     location both reference routes produce. An implicit style carries it to every
                     text block, which a Grid has no FontFamily to inherit from. -->
                <FontFamily x:Key="BrandFont">ms-appx:///ZeroZero.Brand.WinUI/Assets/Fonts/CascadiaMono.ttf#Cascadia Mono</FontFamily>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource BrandFont}"/>
                </Style>

                <ResourceDictionary.ThemeDictionaries>
                    <!-- Declared here rather than resolved from the merged brand dictionary: a
                         consuming application need not have merged it, and a key that misses
                         renders nothing at all. The light values are the darker shades the bracket
                         button measures against a light ground. -->
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="UpdateProgressBrush" Color="#27E0C8"/>
                        <LinearGradientBrush x:Key="UpdateRuleBrush" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#27E0C8" Offset="0"/>
                            <GradientStop Color="#7B8CFF" Offset="1"/>
                        </LinearGradientBrush>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="UpdateProgressBrush" Color="#0F695E"/>
                        <LinearGradientBrush x:Key="UpdateRuleBrush" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0F695E" Offset="0"/>
                            <GradientStop Color="#3F5BE0" Offset="1"/>
                        </LinearGradientBrush>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="UpdateProgressBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                        <SolidColorBrush x:Key="UpdateRuleBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The studio's wordmark gradient as a rule: the brand signature at no cost in height. -->
        <Border Grid.Row="0" Height="3" Background="{ThemeResource UpdateRuleBrush}"/>

        <StackPanel Grid.Row="1" Padding="20,14,20,18" Spacing="8">

            <TextBlock x:Name="AppNameText" FontSize="10"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

            <TextBlock x:Name="HeadlineText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

            <TextBlock x:Name="BodyText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- The release notes under the question, and the reason under a refusal. Capped and
                 scrolled inside: notes of any length must not turn this into a document viewer. -->
            <Border x:Name="DetailCard" Visibility="Collapsed"
                    Padding="10,8,10,8" CornerRadius="4"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="DetailText" FontSize="11" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </ScrollViewer>
            </Border>

            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="6" Margin="0,2,0,0">
                <ProgressBar x:Name="DownloadBar" Minimum="0" Maximum="1" Height="4"
                             Foreground="{ThemeResource UpdateProgressBrush}"/>
                <TextBlock x:Name="ProgressText" FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>

            <!-- One action per line, every button the width of the widest, so their brackets line
                 up into a column. A row would not fit three choices at this width at any scaling.
                 Each symbol is the act: down for a download, forward for later, away for the
                 browser, a tick for read-and-done, a cross for a stop. Every one is a character
                 the brand face actually carries, checked against its character map rather than
                 assumed: a symbol it lacks is drawn by whatever font Windows falls back to, which
                 is a different shape and weight beside the label. -->
            <brand:BrandBracketButtonColumn x:Name="Actions" Spacing="2" Margin="0,4,0,0"
                                            HorizontalAlignment="Center">
                <brand:BrandBracketButton x:Name="InstallButton" Symbol="&#x2193;"/>
                <brand:BrandBracketButton x:Name="LaterButton" Symbol="&#x00BB;"/>
                <brand:BrandBracketButton x:Name="NotesButton" Symbol="&#x2192;"/>
                <brand:BrandBracketButton x:Name="CloseButton" Symbol="&#x2713;" Visibility="Collapsed"/>
                <brand:BrandBracketButton x:Name="CancelButton" Symbol="&#x00D7;" Visibility="Collapsed"/>
            </brand:BrandBracketButtonColumn>

        </StackPanel>

        <!-- Window-only chrome, over the rule's right-hand end, as the About window places its
             own. Hidden while the download runs: the download has a button of its own that stops
             it, and a second cross that only hid the window would mean two ways out meaning two
             different things. -->
        <Button x:Name="DismissButton" Grid.Row="0" Grid.RowSpan="2"
                Content="&#x00D7;" Width="28" Height="28"
                Padding="0" FontSize="10"
                FontFamily="{StaticResource BrandFont}"
                Background="Transparent"
                BorderBrush="Transparent"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,7,7,0"/>
    </Grid>
</Window>
