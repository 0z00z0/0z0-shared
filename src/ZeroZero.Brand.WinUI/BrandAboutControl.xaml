<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ZeroZero.Brand.WinUI.BrandAboutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand typeface: Cascadia Mono, embedded in this library (Assets/Fonts). Grid/StackPanel
         have no FontFamily to inherit from, so it's applied via an implicit TextBlock style
         (covers every TextBlock, including the credit rows added in code-behind) plus an explicit
         BrandFont on each Button's label. Per 0z0-design: Cascadia Mono is the studio's UI/body
         face; Cascadia Code is only for genuine code/terminal surfaces, not this control.
         The URI is scoped to this assembly's folder, the one place the font exists on both
         reference routes; the output root holds it only under a project reference. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="BrandFont">ms-appx:///ZeroZero.Brand.WinUI/Assets/Fonts/CascadiaMono.ttf#Cascadia Mono</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BrandFont}"/>
            </Style>

            <!--
                The Donate button's mark, drawn rather than typed. The hot-beverage character it
                replaced is not in the brand face, so Windows drew it from whatever face it fell
                back to: a colour emoji of a fixed design beside labels in the studio's own face.
                A path scales with the display, takes the theme, and stays the studio's to change.

                Read as a cup at a glance: a tapered body, a handle on the right, a saucer under
                it. Sized in the template at 17 effective pixels, twice the label's cap height
                beside it, and still inside the button's own minimum height so the row it sits in
                does not grow.
            -->

            <!-- A template rather than markup in place: the button is built in code-behind, and
                 LoadContent gives it this tree with its ThemeResource brushes intact, which a
                 shape built in code could not have. -->
            <DataTemplate x:Key="DonateMark">
                <Viewbox Height="17" VerticalAlignment="Center"
                         AutomationProperties.AccessibilityView="Raw">
                    <!-- The canvas is the drawing's own extent, with no margin around it: a
                         viewbox scales what it is given, so empty canvas would come straight off
                         the mark's rendered size. -->
                    <Canvas Width="23.4" Height="19.4">
                        <!-- The cup: a straight rim, a body a little taller than it is wide, and a
                             rounded base. -->
                        <Path Data="M2.5,1.5 H15.5 V8.5 C15.5,12.6 12.6,15.9 9,15.9 C5.4,15.9 2.5,12.6 2.5,8.5 Z"
                              Fill="{ThemeResource DonateMarkBrush}"/>
                        <!-- The handle, open to the right and clear of the body, so the shape
                             cannot read as a beaker. -->
                        <Path Data="M15.5,3.9 H18 C20.4,3.9 22.3,5.8 22.3,8.2 C22.3,10.6 20.4,12.5 18,12.5 H15.5"
                              Stroke="{ThemeResource DonateMarkBrush}" StrokeThickness="2.1"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <!-- The saucer, under the body only and close under it: carried past the
                             handle it reads as a line through the mark rather than a thing the cup
                             stands on. -->
                        <Path Data="M1,18.3 H17"
                              Stroke="{ThemeResource DonateMarkBrush}" StrokeThickness="2.1"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Viewbox>
            </DataTemplate>

            <ResourceDictionary.ThemeDictionaries>

                <!-- "Default" is the dark theme's dictionary, which is WinUI's own naming. The
                     palette's orange as it is; on a light ground it measures too pale to read, so
                     light takes the darker shade of the same hue that BrandBracketButton already
                     uses for its own orange. One light orange in the component, not two. -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="DonateMarkBrush" Color="#E0872A"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DonateMarkBrush" Color="#895014"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="DonateMarkBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The card draws its own frame: a rounded stroke here rather than a border the host wraps
         around the control. A wrapper sits outside the header band, whose square corners break
         out of it, and has to be corrected every time this layout moves; the frame belongs where
         the layout is. No background, so a Mica host still shows the backdrop through the body. -->
    <Border x:Name="Root"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <StackPanel>

            <!-- ── Brand header: unified brand navy (not per-app tinted, not theme-adaptive — this is
                 fixed studio identity, deliberately not a ThemeResource; see class doc). Its corners
                 are the frame's own, so the band stops where the stroke turns. ────────────────────── -->
            <Border Padding="16,12,16,12" CornerRadius="8,8,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#15263A" Offset="0"/>
                        <GradientStop Color="#0A0F17" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- [Ø] studio mark -->
                    <Viewbox Width="72" Height="72" Grid.Column="0" VerticalAlignment="Center">
                        <Canvas Width="256" Height="256">
                            <!-- Background plate: per 0z0-design/logo/GUIDE.md, the studio mark
                                 carries its own rounded-square radial-gradient plate wherever the
                                 full mark is used (About-box credits is an explicitly named
                                 context) — not just the header's own background. -->
                            <Rectangle Width="240" Height="240" Canvas.Left="8" Canvas.Top="8"
                                       RadiusX="52" RadiusY="52">
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="0.5,0.35" RadiusX="0.85" RadiusY="0.85">
                                        <GradientStop Color="#15263A" Offset="0"/>
                                        <GradientStop Color="#0A0F17" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <!-- Left bracket "[" -->
                            <Path Data="M104,78 H82 V178 H104" StrokeThickness="15"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#27E0C8" Offset="0"/>
                                        <GradientStop Color="#11A9D6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Stroke>
                            </Path>
                            <!-- Right bracket "]" -->
                            <Path Data="M152,78 H174 V178 H152" StrokeThickness="15"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#7B8CFF" Offset="0"/>
                                        <GradientStop Color="#3F5BE0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Stroke>
                            </Path>
                            <!-- "0" of the Ø -->
                            <Rectangle Width="32" Height="80" Canvas.Left="112" Canvas.Top="88"
                                       RadiusX="12" RadiusY="12" Stroke="#D8A657" StrokeThickness="10" Fill="Transparent"/>
                            <!-- Slash of the Ø -->
                            <Line X1="148" Y1="92" X2="108" Y2="164" Stroke="#D8A657" StrokeThickness="6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>

                    <!-- App name + version -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                Margin="10,0,0,0" Spacing="2">
                        <TextBlock x:Name="AppNameText" Text="App"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock x:Name="VersionText" Text="v—"
                                   FontSize="11" Foreground="#80FFFFFF"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Body (inherits the host's theme via ThemeResource brushes) ─────────────────── -->
            <StackPanel Padding="16,12,16,16" Spacing="10">

                <!-- Studio wordmark: teal→purple gradient text. Plain (non-interactive) text, not a
                     button — the "Website" link below already covers that action; making the wordmark
                     clickable too would just be a second control doing the exact same thing. -->
                <StackPanel Spacing="2">
                    <TextBlock FontSize="12" FontWeight="SemiBold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#27E0C8" Offset="0"/>
                                <GradientStop Color="#7B8CFF" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        ZeroZero Software
                    </TextBlock>
                    <TextBlock Text="Small tools. Zero bloat."
                               FontSize="10"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <!-- App description -->
                <TextBlock x:Name="DescriptionText"
                    FontSize="11" TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <!-- Website | Donate | What's new | the host's own buttons, built in code-behind on a
                     panel that wraps at narrow widths and gives a collapsed button no room at all. No
                     "Check for Updates" here; that is BrandAboutWindow's. "What's new" shows the notes in
                     the panel below rather than handing the reader to a browser. -->
                <Border x:Name="ButtonRowSlot" Margin="0,2,0,0"/>

                <!-- The notes themselves, in the About surface rather than a browser. Collapsed until
                     asked for, so a reader who never presses the button pays no fetch and no height.
                     Capped and scrolled inside: the host is a small window, and notes of any length
                     must not turn it into a document viewer. -->
                <Border x:Name="NewsPanel" Visibility="Collapsed"
                        Padding="10,8,10,8" CornerRadius="4"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="NewsText"
                                   FontSize="10" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </ScrollViewer>
                </Border>

                <!-- External libraries (collapsed by default; hidden entirely if empty).
                     A plain text toggle rather than a full Expander control — the built-in
                     Expander's card chrome (background, border, full-width header) reads as a
                     prominent action row; local Background/BorderThickness overrides on it don't
                     fully strip that, since the header's own theme-resource brushes still apply.
                     A small link-styled Button is a deliberately low-key credits footnote. -->
                <StackPanel x:Name="LibrariesGroup" Spacing="4">
                    <Button x:Name="LibrariesToggleBtn" Click="OnLibrariesToggle"
                            Content="External libraries ▾"
                            FontSize="9" FontFamily="{StaticResource BrandFont}"
                            Padding="0" MinWidth="0" MinHeight="0"
                            Background="Transparent" BorderBrush="Transparent"
                            HorizontalAlignment="Left"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <StackPanel x:Name="LibrariesPanel" Spacing="6" Padding="0,2,0,0"
                                Visibility="Collapsed"/>
                </StackPanel>

                <!-- Footer -->
                <TextBlock x:Name="FooterText"
                           FontSize="9" Opacity="0.7"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
