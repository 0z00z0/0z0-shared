<Project>

  <!--
    Puts the brand typeface and its licence into a published application at the path the markup
    names, ZeroZero.Brand.WinUI\Assets\Fonts\. A consuming build copies them there by itself: the
    Windows App SDK tooling expands this library's .pri and adds the files it lists to the build's
    copy. That copy belongs to the build alone, so without this file a publish carries neither file
    and the face silently falls back.

    Each file joins the publish set only where the publish does not already hold its relative path,
    so a toolchain that starts publishing them itself meets no duplicate.
  -->
  <Target Name="ZeroZeroBrandAssetsToPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_ZeroZeroBrandPublishAsset Include="$(MSBuildThisFileDirectory)..\lib\*\ZeroZero.Brand.WinUI\Assets\Fonts\CascadiaMono.ttf" />
      <_ZeroZeroBrandPublishAsset Include="$(MSBuildThisFileDirectory)..\lib\*\ZeroZero.Brand.WinUI\Assets\Fonts\LICENCE-OFL.txt" />
    </ItemGroup>

    <!-- A package that no longer carries both files at that path would otherwise publish an
         application without the face and say nothing. -->
    <Error Condition="'@(_ZeroZeroBrandPublishAsset->Count())' != '2'"
           Text="ZeroZero.Brand.WinUI: expected CascadiaMono.ttf and LICENCE-OFL.txt under lib\&lt;tfm&gt;\ZeroZero.Brand.WinUI\Assets\Fonts\ in the package at $(MSBuildThisFileDirectory)..\ and found @(_ZeroZeroBrandPublishAsset->Count()) file(s), so the published application would carry no brand typeface." />

    <ItemGroup>
      <_ZeroZeroBrandPublishAsset RelativePath="ZeroZero.Brand.WinUI\Assets\Fonts\%(Filename)%(Extension)"
                                  CopyToPublishDirectory="PreserveNewest" />
      <_ZeroZeroBrandPublishAsset Remove="@(ResolvedFileToPublish)"
                                  MatchOnMetadata="RelativePath"
                                  MatchOnMetadataOptions="PathLike" />
      <ResolvedFileToPublish Include="@(_ZeroZeroBrandPublishAsset)" />
      <_ZeroZeroBrandPublishAsset Remove="@(_ZeroZeroBrandPublishAsset)" />
    </ItemGroup>
  </Target>

</Project>
