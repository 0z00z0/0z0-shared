<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ZeroZero.Brand.WinUI</RootNamespace>
    <Version>$(BrandVersion)</Version>

    <!-- WinUI 3 / Windows App SDK, unpackaged (no MSIX) — a class library consumed by unpackaged
         apps, so it must not pull in packaging tooling itself. -->
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>

    <AssemblyTitle>ZeroZero.Brand.WinUI</AssemblyTitle>
    <Product>ZeroZero.Brand.WinUI</Product>
    <Description>Shared WinUI 3 About-window component for ZeroZero Software apps.</Description>
  </PropertyGroup>

  <!--
    The Windows App SDK / SDK.BuildTools versions are the family's pins in the build kit's
    ZeroZero.Packages.props, which Directory.Packages.props imports; a pin moves there and nowhere
    else, so a consumer under the kit resolves the runtime this library was built against.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroZero.Brand.Core\ZeroZero.Brand.Core.csproj" />
    <!-- Foundation: monitor and DPI metrics for centring the About window. -->
    <ProjectReference Include="..\ZeroZero.Win32\ZeroZero.Win32.csproj" />
  </ItemGroup>

  <!--
    Brand typeface: Cascadia Mono (0z0-design/fonts). Shipped as Content so it travels with the
    library into every consuming app's output under Assets\Fonts\ — BrandAboutWindow references it
    by that relative path, so consumers get the correct brand face with no per-app setup. The OFL
    licence must accompany any redistributed copy of the font, so it ships alongside.

    Inside the package they go beside the assembly, not to NuGet's default content\ and
    contentFiles\: a consuming build resolves a referenced WinUI library's assets from
    lib\<tfm>\<assembly>\Assets\, the folder the markup compiler already writes the compiled XAML
    into, so the default destinations leave it copying from a path the package does not carry and
    its build fails with two MSB3030 errors.

    That folder is NuGet's short form of TargetFramework, which no property exposes while this file
    is evaluated, so it is written out and PackagePathMatchesTargetFramework below fails the pack if
    the two ever part company.
  -->
  <PropertyGroup>
    <BrandAssetPackagePath>lib\net10.0-windows10.0.26100\$(MSBuildProjectName)\Assets\Fonts\</BrandAssetPackagePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- An implicit glob has already taken everything under Assets\ as Content, so an Include on
         its own leaves two items per file and packs each of them to a different destination. -->
    <Content Remove="Assets\Fonts\**" />
    <Content Include="Assets\Fonts\CascadiaMono.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>$(BrandAssetPackagePath)</PackagePath>
    </Content>
    <Content Include="Assets\Fonts\LICENCE-OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>$(BrandAssetPackagePath)</PackagePath>
    </Content>
  </ItemGroup>

  <Target Name="PackagePathMatchesTargetFramework" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(TargetFramework)' != 'net10.0-windows10.0.26100.0'"
           Text="BrandAssetPackagePath names lib\net10.0-windows10.0.26100, which was NuGet's short form of net10.0-windows10.0.26100.0. TargetFramework is now $(TargetFramework), so the fonts would pack to a folder no consumer looks in and every consuming build would fail with MSB3030. Update both." />
  </Target>

</Project>
