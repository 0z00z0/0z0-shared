<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ZeroZero.Brand.WinUI.BrandAboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:brand="using:ZeroZero.Brand.WinUI">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <!-- Thin shell around BrandAboutControl: Mica backdrop, no title bar, sizing/centring/close,
         and the window-only "Check for Updates" action. The About *content* (brand header, links,
         credits) lives in the hosted control so it can also be embedded in a host app's own
         in-navigation page with none of this chrome (see BrandAboutControl's class doc). -->
    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- Merged again here: the hosted control's resources do not cascade out to this
                 window's own close and update buttons. -->
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///ZeroZero.Brand.WinUI/Themes/BrandFont.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <StackPanel>
            <brand:BrandAboutControl x:Name="AboutControl"/>

            <!-- Check for Updates: window-only, beneath the card rather than inside it, since the
                 card draws its own frame. Padding matches the card's body padding, so the button
                 lines up with what sits above it. -->
            <StackPanel Padding="16,12,16,16">
                <Button x:Name="UpdateBtn"
                        FontSize="11" FontFamily="{StaticResource BrandFontFamily}"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </StackPanel>

        <!-- Close button: window-only chrome, overlaid on the header band's top-right corner
             (Margin approximates the band's own 16,12,16,12 padding so the two line up).
             U+00D7, the multiplication sign, because Cascadia Mono carries it. A character missing
             from Cascadia Mono is drawn from a fallback face in a different shape and weight, in a
             window that is otherwise one face throughout. -->
        <Button x:Name="CloseBtn"
                Content="&#x00D7;" Width="32" Height="32"
                Padding="0" FontSize="11"
                FontFamily="{StaticResource BrandFontFamily}"
                Background="Transparent"
                BorderBrush="Transparent"
                Foreground="#80FFFFFF"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,12,12,0"/>
    </Grid>
</Window>
