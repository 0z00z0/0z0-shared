<Project>

  <!-- One version per component, and nothing else. The property is <Key>Version, where the key is
       the first segment of the assembly name after ZeroZero. — ZeroZero.Mqtt.WinUI is mqtt — and
       every packable project of that key declares <Version>$(<Key>Version)</Version>. A release
       tag is <key>-v<x.y.z>; .github/workflows/release.yml refuses a tag that disagrees with the
       property or with any project it selects. Pre-1.0 per component: the minor may break, the
       patch never does.

       Every component starts at 0.7.0. Up to and including 0.6.0 one number released every package
       that existed then — six of the twenty-one on the feed today — so 0.6.0 and below means
       "released together" and 0.7.0 and above means "released on its own". The other fifteen came
       after that era and have no number below 0.7.0 at all, so a version range starting there
       finds nothing. A published number never moves backwards. -->
  <PropertyGroup>
    <BrandVersion>0.11.1</BrandVersion>
    <BuildVersion>0.9.1</BuildVersion>
    <ConfigVersion>0.8.1</ConfigVersion>
    <ControlsVersion>0.8.1</ControlsVersion>
    <DiagnosticsVersion>0.7.1</DiagnosticsVersion>
    <LifecycleVersion>0.7.1</LifecycleVersion>
    <MqttVersion>0.11.0</MqttVersion>
    <PrimitivesVersion>0.7.0</PrimitivesVersion>
    <SettingsShellVersion>0.8.1</SettingsShellVersion>
    <StartupVersion>0.8.2</StartupVersion>
    <TrayVersion>0.9.1</TrayVersion>
    <UpdateVersion>0.13.1</UpdateVersion>
    <Win32Version>0.9.1</Win32Version>
  </PropertyGroup>

</Project>
